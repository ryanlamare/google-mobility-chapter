. foreach y in workplacemob residentmob {
  2.     display _n "==== `y', lockdown 2020 ===="
  3.     quietly reg `y' c.um_cps##c.blackalone_prop c.um_cps##c.per_gop `contr
> ols'
  4.     quietly summarize um_cps if e(sample), detail
  5.     local u10 = r(p10)
  6.     local u90 = r(p90)
  7.     quietly summarize blackalone_prop if e(sample), detail
  8.     local b10 = r(p10)
  9.     local b90 = r(p90)
 10.     display "union membership p10/p90: `u10' / `u90'; Black share p10/p90:
>  `b10' / `b90'"
 11.     /*the lines in Figure 3*/
.     margins, at(um_cps=(`u10' `u90') blackalone_prop=(0(.05).5)) saving("outp
> ut/margins_`y'.dta", replace)
 12.     /*predictions at the 10th and 90th percentiles of both measures*/
.     margins, at(um_cps=(`u10' `u90') blackalone_prop=(`b10' `b90')) pwcompare
> (effects)
 13.     /*difference in the Black-share effect between high and low union memb
> ership*/
.     lincom (`u90' - `u10') * (`b90' - `b10') * c.um_cps#c.blackalone_prop
 14. }

